# ── App ──────────────────────────────────────────────────────────────
APP_NAME=Wow Gift API
APP_VERSION=0.1.0
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./wow_gift.db
# PostgreSQL (production) – uncomment and set:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/wow_gift

# ── JWT ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── i18n ─────────────────────────────────────────────────────────────
DEFAULT_LOCALE=ar

# ── Currency (Iraq) ──────────────────────────────────────────────────
DEFAULT_CURRENCY=IQD

# ── Merchant Payout ──────────────────────────────────────────────────
MERCHANT_COMMISSION_RATE=10.0
MERCHANT_PAYOUT_DAY=sunday
MERCHANT_MIN_PAYOUT_THRESHOLD=50000.0

# ── OTP / Phone Verification ────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=5
# WARNING: OTP_DEV_MODE MUST be False in production — it exposes the OTP
# code in the API response (dev_code field).
OTP_DEV_MODE=true
# Provider: "mock" (logs code, returns dev_code) | "twilio" (real SMS/WhatsApp)
OTP_PROVIDER=mock

# ── Twilio (required only when OTP_PROVIDER=twilio) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
